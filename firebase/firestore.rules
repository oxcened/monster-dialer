rules_version = '2';
service cloud.firestore {
  // Shared profile documents contain only displayable character metadata and
  // sprite references. The private owner index maps a Firebase Auth UID to its
  // one active profile ID. `retentionConfirmedAt` is a server timestamp used
  // only by the profile-retention policy.
  //
  // Assumed public document schema:
  // - schemaVersion: integer 1
  // - publicProfileId: the document ID
  // - revision: positive integer, advanced for profile-content changes
  // - updatedAt / retentionConfirmedAt: server timestamps
  // - trainer: { name, frontSprite }
  // - monster: { name, level, maxHp, frontSprite }
  // - frontSprite: canonical Storage path, SHA-256, decoded dimensions, size
  //
  // Assumed private owner-index schema:
  // - document ID: the Firebase Auth UID
  // - activeProfileId: the owner's active public profile ID
  // - updatedAt: server timestamp
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function ownerIndex(ownerUid) {
      return /databases/$(database)/documents/onlineProfileOwners/$(ownerUid);
    }

    function ownsProfile(profileId) {
      return isAuthenticated()
        && exists(ownerIndex(request.auth.uid))
        && get(ownerIndex(request.auth.uid)).data.activeProfileId == profileId;
    }

    function isValidSprite(sprite, profileId, spriteName) {
      return sprite is map
        && sprite.keys().hasOnly(['storagePath', 'sha256', 'width', 'height', 'byteSize'])
        && sprite.storagePath is string
        && sprite.storagePath == 'onlineProfiles/' + profileId + '/sprites/' + spriteName + '.png'
        && sprite.sha256 is string
        && sprite.sha256.matches('^[a-f0-9]{64}$')
        && sprite.width is int
        && sprite.width >= 1 && sprite.width <= 1024
        && sprite.height is int
        && sprite.height >= 1 && sprite.height <= 1024
        && sprite.byteSize is int
        && sprite.byteSize >= 1 && sprite.byteSize < 2 * 1024 * 1024;
    }

    function isValidTrainer(trainer, profileId) {
      return trainer is map
        && trainer.keys().hasOnly(['name', 'frontSprite'])
        && trainer.name is string
        && trainer.name.size() >= 1 && trainer.name.size() <= 120
        && isValidSprite(trainer.frontSprite, profileId, 'trainer');
    }

    function isValidMonster(monster, profileId) {
      return monster is map
        && monster.keys().hasOnly(['name', 'level', 'maxHp', 'frontSprite'])
        && monster.name is string
        && monster.name.size() >= 1 && monster.name.size() <= 120
        && monster.level is int
        && monster.level >= 1 && monster.level <= 999
        && monster.maxHp is int
        && monster.maxHp >= 1 && monster.maxHp <= 999
        && isValidSprite(monster.frontSprite, profileId, 'monster');
    }

    function isValidProfile(profileId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'publicProfileId', 'revision', 'updatedAt', 'retentionConfirmedAt', 'trainer', 'monster'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'publicProfileId', 'revision', 'updatedAt', 'retentionConfirmedAt', 'trainer', 'monster'
        ])
        && profileId.matches('^[A-Za-z0-9_-]{22,128}$')
        && request.resource.data.publicProfileId == profileId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.retentionConfirmedAt is timestamp
        && isValidTrainer(request.resource.data.trainer, profileId)
        && isValidMonster(request.resource.data.monster, profileId);
    }

    function isValidOwnerIndex() {
      return request.resource.data.keys().hasAll(['activeProfileId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeProfileId', 'updatedAt'])
        && request.resource.data.activeProfileId is string
        && request.resource.data.activeProfileId.matches('^[A-Za-z0-9_-]{22,128}$')
        && request.resource.data.updatedAt is timestamp;
    }

    function timestampsAreValidForUpdate() {
      let onlyRetentionChanged = request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['retentionConfirmedAt']);
      return (onlyRetentionChanged
          && request.resource.data.revision == resource.data.revision
          && request.resource.data.updatedAt == resource.data.updatedAt
          && request.resource.data.retentionConfirmedAt == request.time)
        || (!onlyRetentionChanged
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.retentionConfirmedAt == resource.data.retentionConfirmedAt
            || request.resource.data.retentionConfirmedAt == request.time));
    }

    match /onlineProfiles/{profileId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidProfile(profileId)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.retentionConfirmedAt == request.time
        && getAfter(ownerIndex(request.auth.uid)).data.activeProfileId == profileId;
      allow update: if ownsProfile(profileId)
        && isValidProfile(profileId)
        && timestampsAreValidForUpdate();
      allow delete: if ownsProfile(profileId);
    }

    match /onlineProfileOwners/{ownerUid} {
      allow get: if isOwner(ownerUid);
      allow list: if false;
      allow create: if isOwner(ownerUid)
        && isValidOwnerIndex()
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/onlineProfiles/$(request.resource.data.activeProfileId))
        && getAfter(/databases/$(database)/documents/onlineProfiles/$(request.resource.data.activeProfileId)).data.publicProfileId == request.resource.data.activeProfileId;
      allow update: if isOwner(ownerUid)
        && isValidOwnerIndex()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.activeProfileId != resource.data.activeProfileId
        && !exists(/databases/$(database)/documents/onlineProfiles/$(request.resource.data.activeProfileId))
        && getAfter(/databases/$(database)/documents/onlineProfiles/$(request.resource.data.activeProfileId)).data.publicProfileId == request.resource.data.activeProfileId
        && !existsAfter(/databases/$(database)/documents/onlineProfiles/$(resource.data.activeProfileId));
      allow delete: if isOwner(ownerUid)
        && !existsAfter(/databases/$(database)/documents/onlineProfiles/$(resource.data.activeProfileId));
    }
  }
}
