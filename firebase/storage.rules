rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /onlineProfiles/{profileId}/sprites/{objectName} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && objectName.matches('^(trainer|monster)\\.png$')
        && request.resource.contentType == 'image/png'
        && request.resource.size < 2 * 1024 * 1024
        && firestore.get(/databases/(default)/documents/onlineProfiles/$(profileId)/private/ownership).data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && objectName.matches('^(trainer|monster)\\.png$')
        && firestore.get(/databases/(default)/documents/onlineProfiles/$(profileId)/private/ownership).data.ownerUid == request.auth.uid;
    }
  }
}
